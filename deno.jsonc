{
  "name": "@bounded-systems/lone",
  "version": "0.8.0",
  "license": "MIT",
  "exports": "./src/mod.ts",
  // Node metadata for the org knowledge graph (bounded-systems/.github-private
  // → registry/). `facet`/`role`/`domain` are the label gate: without them
  // `registry/generate.ts --check` reports this package as unlabeled. The values
  // match the reviewed seed entry in registry/seed.json; authoring them here is
  // what moves the node from "seeded" to "labeled". Schema:
  // registry/bounded-metadata.schema.json.
  "bounded": {
    "tagline": "Bless untrusted DOM subtrees into typed Blessed<T> values or structured Finding[] — a verification boundary for semantic safety",
    "kind": "door",
    "facet": "verb",
    "role": "runtime",
    "domain": "validation/dom",
    "contract": "./src/mod.ts"
  },
  "imports": {
    "zod": "npm:zod@3",
    "linkedom": "npm:linkedom@0.15.3",
    "@std/assert": "jsr:@std/assert@^1",
    "fast-check": "npm:fast-check@3"
  },
  // Three files in this repo are written by the org Claude harness, not by lone:
  // CLAUDE.md's managed block ("do not hand-edit this block"), .claude/, and
  // .github/workflows/front-desk-add.yml (whose own header names itself a rolled
  // copy of a canonical template, audited by audit-front-desk-add.sh). All three
  // arrive without a trailing newline, and `deno fmt` here takes no path
  // arguments — so it covers Markdown, JSON and YAML too and rejects them. That
  // is why `deno task ci` has been red on main since 2026-08-08 (#35).
  //
  // Excluded rather than reformatted: formatting them would be the hand-edit two
  // of them forbid, would fail the front-desk-add audit, and would be undone by
  // the next harness re-roll — red again, same three files. They are not lone's
  // source; the generator side is filed at bounded-systems/.github#247.
  "fmt": {
    "exclude": [
      "CLAUDE.md",
      ".claude/",
      ".github/workflows/front-desk-add.yml"
    ]
  },

  "lint": {
    "rules": {
      // no-slow-types requires rewriting z.infer<> chains throughout the Zod schemas.
      // Excluded for v0.1.0; publish with --allow-slow-types until this is addressed.
      "exclude": ["no-slow-types"]
    }
  },
  "tasks": {
    "test": "deno test -A --fail-fast tests",
    "test:watch": "deno test -A --watch tests",
    "bench": "deno bench -A tests/bench",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check **/*.ts",
    "ci": "deno fmt --check && deno lint && deno check **/*.ts && deno test -A --fail-fast tests",
    "pre-commit": "deno task ci"
  }
}
